{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "'Cinzel', 'Cormorant Garamond', Georgia, serif",
        "$type": "fontFamily",
        "$description": "Classical institutional serif inspired by the JBA logo and Greco-Roman legal authority"
      },
      "body": {
        "$value": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily",
        "$description": "High-legibility modern geometric sans-serif for public administration data, forms, and editais"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', monospace",
        "$type": "fontFamily",
        "$description": "Monospace font for CPF, Protocol Numbers, SHA-256 verification hashes, and legal articles"
      }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension", "px": 12 },
      "sm": { "$value": "0.875rem", "$type": "dimension", "px": 14 },
      "base": { "$value": "1rem", "$type": "dimension", "px": 16 },
      "lg": { "$value": "1.125rem", "$type": "dimension", "px": 18 },
      "xl": { "$value": "1.25rem", "$type": "dimension", "px": 20 },
      "2xl": { "$value": "1.5rem", "$type": "dimension", "px": 24 },
      "3xl": { "$value": "1.875rem", "$type": "dimension", "px": 30 },
      "4xl": { "$value": "2.25rem", "$type": "dimension", "px": 36 },
      "5xl": { "$value": "3rem", "$type": "dimension", "px": 48 },
      "6xl": { "$value": "3.75rem", "$type": "dimension", "px": 60 }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": 1.15, "$type": "number" },
      "snug": { "$value": 1.3, "$type": "number" },
      "normal": { "$value": 1.6, "$type": "number" },
      "relaxed": { "$value": 1.75, "$type": "number" }
    },
    "letterSpacing": {
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em", "$type": "dimension" },
      "wide": { "$value": "0.06em", "$type": "dimension" },
      "institutional": { "$value": "0.14em", "$type": "dimension" },
      "tagline": { "$value": "0.22em", "$type": "dimension" }
    }
  }
}
